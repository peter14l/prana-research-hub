# ==============================================================================
# PRANA Research Hub - Environment Variables
# ==============================================================================

# Project Metadata
PROJECT_NAME="PRANA Research Hub"
ENVIRONMENT="development"

# Server Configuration
API_HOST="127.0.0.1"
API_PORT="8000"
FRONTEND_PORT="3000"

# Database Configuration
# Default: Zero-setup embedded SQLite file (No Docker or external database server required)
DATABASE_URL="sqlite:///./backend/data/prana.db"

# Optional PostgreSQL / PostGIS connection string (if deploying to external cloud database)
# DATABASE_URL="postgresql://prana_user:prana_password@localhost:5432/prana_db"

# Optional External API Keys (Platform functions out-of-the-box with embedded telemetry & free open tiers)
OPENAQ_API_KEY=""
GEMINI_API_KEY=""

# Study Area Geographic Scope (Kolkata–Howrah Conurbation)
REGION_NAME="Kolkata–Howrah"
MIN_LAT=22.45
MAX_LAT=22.68
MIN_LNG=88.22
MAX_LNG=88.48
CENTER_LAT=22.5726
CENTER_LNG=88.3639
